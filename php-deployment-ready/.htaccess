# ==============================================================================
# إعدادات خادم Apache لـ منظومة تدبير الأقسام والغياب والسلوك
# مهيأ تماماً ليعمل كمنصة CMS مثل WordPress على أي استضافة (cPanel / Apache / LiteSpeed)
# ==============================================================================

# إجبار الخادم على تشغيل index.php كفهرس أولي لمنع تجاوز معالج التثبيت
DirectoryIndex index.php app.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. توجيه جميع طلبات API إلى سكربت PHP الموحد
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api$ api/index.php [QSA,L]

  # 3. السماح بمرور الملفات الثابتة والمجلدات الموجودة فعلياً
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. توجيه كافة المسارات المتبقية إلى المتحكم index.php
  RewriteRule ^ index.php [L]
</IfModule>

# حماية ملفات الإعدادات والبيانات الحساسة
<FilesMatch "^(config\.php|database\.sql|installed\.lock|\.env.*)$">
  Order allow,deny
  Deny from all
</FilesMatch>
